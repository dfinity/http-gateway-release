# syntax=docker/dockerfile:1

# https://snapshot.debian.org/archive/debian/20261020T202723Z/
ARG SNAPSHOT=20261020T202723Z

FROM debian:trixie-20261020-slim AS base

ENV DEBIAN_FRONTEND=noninteractive

RUN \
  : "Enabling snapshot" && \
  sed -i -e '/Types: deb/ a\Snapshot: true' /etc/apt/sources.list.d/debian.sources && \
  : "Enabling cache" && \
  rm -f /etc/apt/apt.conf.d/docker-clean && \
  echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' >/etc/apt/apt.conf.d/keep-cache


# node_exporter is released with debug info, strip it using binutils from the same snapshot

FROM base AS strip

ARG SNAPSHOT

RUN \
  --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  apt install --update --snapshot "${SNAPSHOT}" -o Acquire::Check-Valid-Until=false -o Acquire::https::Verify-Peer=false -y --no-install-recommends binutils

COPY bin/node_exporter /node_exporter

RUN strip /node_exporter


FROM base

ARG SNAPSHOT

RUN \
  --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  : "Fetching the snapshot and installing ca-certificates in one command" && \
  apt install --update --snapshot "${SNAPSHOT}" -o Acquire::Check-Valid-Until=false -o Acquire::https::Verify-Peer=false -y --no-install-recommends ca-certificates && \
  : "Install dependencies, systemd-standalone-sysusers satisfies the systemd dependency of openssh-server and udev" && \
  apt install --snapshot "${SNAPSHOT}" -y --no-install-recommends \
  chrony \
  curl \
  iproute2 \
  kmod \
  nano \
  nftables \
  openssh-server \
  procps \
  runit \
  systemd-standalone-sysusers \
  tcpdump && \
  : "Install kernel" && \
  apt install --snapshot "${SNAPSHOT}" -y --no-install-recommends linux-image-cloud-amd64 && \
  : "Remove the initrd generated by initramfs-tools, the image itself is the initramfs" && \
  rm -f /boot/initrd.img-* /initrd.img /initrd.img.old && \
  : "Remove the kernel symlinks, the kernel is moved out of the image by the Makefile" && \
  rm -f /vmlinuz /vmlinuz.old && \
  : "Keep only the kernel modules that can be loaded. There's no udev, so drivers are only loaded by /init," && \
  : "everything else is loaded by the kernel on demand (netfilter, crypto, filesystems etc)" && \
  KVER=$(ls /usr/lib/modules) && \
  KDIR="/usr/lib/modules/${KVER}/kernel" && \
  modprobe -S "${KVER}" --show-depends -a \
  virtio_net virtio_scsi sd_mod sev-guest vfat isofs udf \
  $(find "${KDIR}/net/netfilter" "${KDIR}/net/ipv4" "${KDIR}/net/ipv6" "${KDIR}/net/sched" "${KDIR}/net/core" \
  "${KDIR}/crypto" "${KDIR}/lib" "${KDIR}/arch" "${KDIR}/fs/nls" -name '*.ko*' | sed -e 's|.*/||' -e 's|\.ko.*||') \
  > /tmp/modules.dep && \
  awk '$1 == "insmod" { print $2 }' /tmp/modules.dep | xargs realpath > /tmp/modules.keep && \
  find "${KDIR}" -name '*.ko*' | grep -vxF -f /tmp/modules.keep | xargs rm -f && \
  find "${KDIR}" -type d -empty -delete && \
  depmod "${KVER}" && \
  rm /tmp/modules.dep /tmp/modules.keep

# Purging apt removes /var/cache/apt and /var/lib/apt, so this can't be done in the RUN above where they're cache mounts

RUN \
  : "Remove packages only needed at install time:" && \
  : "- initramfs-tools (and udev it depends on) only generates the initrd that is removed above" && \
  : "- perl is only used by the maintainer scripts of sysuser-helper (a dependency of runit)" && \
  : "- apt isn't used at runtime" && \
  dpkg --purge --force-depends \
  initramfs-tools initramfs-tools-core initramfs-tools-bin klibc-utils libklibc dracut-install cpio logsave udev libsystemd-shared linux-base \
  sysuser-helper perl perl-modules-5.40 libperl5.40 \
  apt libapt-pkg7.0 sqv debian-archive-keyring && \
  : "Remove the runit services shipped by the packages, only the ones from etc/sv are used" && \
  rm -rf /etc/sv

# binaries

COPY --chmod=755 bin/ic-gateway /usr/bin/ic-gateway
COPY --chmod=755 bin/ic-http-lb /usr/bin/ic-http-lb
COPY --chmod=755 --from=strip /node_exporter /usr/bin/node_exporter


# crowdsec

RUN curl -fsSL -o crowdsec-firewall-bouncer-linux-amd64.tgz https://github.com/crowdsecurity/cs-firewall-bouncer/releases/download/v0.0.31/crowdsec-firewall-bouncer-linux-amd64.tgz && \
  echo "e4f6ed09fd9ce74117c2bc3db950326304cc741e1f6f532583d35b73a42dbad9  crowdsec-firewall-bouncer-linux-amd64.tgz" | sha256sum -c && \
  tar xzf crowdsec-firewall-bouncer-linux-amd64.tgz && \
  cp crowdsec-firewall-bouncer-v0.0.31/crowdsec-firewall-bouncer /usr/bin/crowdsec-firewall-bouncer && \
  rm -rf crowdsec-firewall-bouncer-linux-amd64.tgz crowdsec-firewall-bouncer-v0.0.31


# firewall

COPY etc/crowdsec /etc/crowdsec
COPY etc/nftables.conf /etc/nftables.conf


# network tweaks
COPY etc/sysctl.d /etc/sysctl.d


# service definitions (runit)

COPY etc/sv /etc/sv

# misc
COPY etc/hosts /etc/hosts

# init

COPY --chmod=755 init.sh /init

RUN \
  : "Clean up for improving reproducibility" && \
  rm -rf /var/log/* /var/cache/ldconfig/aux-cache
