#!/bin/sh
exec 2>&1

# Publishes chrony's state as Prometheus metrics through node_exporter's textfile collector

DIR='/run/node_exporter'
OUT="${DIR}/chrony.prom"
WORK='/run/chrony-metrics'
INTERVAL=15

mkdir -p "$DIR" "$WORK"

# Only use the Unix socket, so that a stopped chronyd fails fast instead of timing out over UDP
CHRONYC='chronyc -h /run/chrony/chronyd.sock -c'

while :; do
    # Every command runs even if chronyd is down, so that no stale output is left behind.
    $CHRONYC -N tracking >"${WORK}/tracking" 2>/dev/null
    $CHRONYC -n sources >"${WORK}/sources" 2>/dev/null
    $CHRONYC -n authdata >"${WORK}/authdata" 2>/dev/null

    # Source names from the config as "address,name", looked up by address so that they still match
    # if the source list changes between the queries. Addresses without a name (sources removed
    # meanwhile, reference clocks) are labeled with the address.
    { cut -d, -f3 "${WORK}/sources"; cut -d, -f1 "${WORK}/authdata"; } | sort -u |
    while read -r addr; do
        name=$($CHRONYC sourcename "$addr" </dev/null 2>/dev/null) && echo "${addr},${name}"
    done >"${WORK}/names"

    # Write to a file that doesn't match *.prom and rename it, so a scrape never sees a partial file
    TMP=$(mktemp "${OUT}.XXXXXX")
    awk -f /etc/sv/chrony-metrics/chrony-metrics.awk \
        "${WORK}/tracking" "${WORK}/names" "${WORK}/sources" "${WORK}/authdata" \
        >"$TMP"
    chmod 644 "$TMP"
    mv "$TMP" "$OUT"

    sleep $INTERVAL
done
